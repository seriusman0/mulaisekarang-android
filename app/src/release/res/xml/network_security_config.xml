<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production traffic is HTTPS-only (https://v2.mulaisekarang.com) — no cleartext exceptions here.
         Dev/emulator cleartext exceptions live only in src/debug/res/xml/network_security_config.xml. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
