<?xml version="1.0" encoding="utf-8"?>
<!-- Crisp vector recreation of the 4-petal "Mulai Sekarang" mark (was previously a blurry
     137x137px raster bitmap inset). Renders perfectly at any density/size, including the
     512x512 Play Store listing icon derived from the matching SVG in store-assets/. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top-left petal: purple -->
    <path
        android:fillColor="#7C3AED"
        android:pathData="M30,22 L44,22 A8,8 0 0 1 52,30 L52,52 L30,52 A8,8 0 0 1 22,44 L22,30 A8,8 0 0 1 30,22 Z" />

    <!-- Top-right petal: blue -->
    <path
        android:fillColor="#2563EB"
        android:pathData="M64,22 L78,22 A8,8 0 0 1 86,30 L86,44 A8,8 0 0 1 78,52 L56,52 L56,30 A8,8 0 0 1 64,22 Z" />

    <!-- Bottom-left petal: orange -->
    <path
        android:fillColor="#F97316"
        android:pathData="M30,56 L52,56 L52,78 A8,8 0 0 1 44,86 L30,86 A8,8 0 0 1 22,78 L22,64 A8,8 0 0 1 30,56 Z" />

    <!-- Bottom-right petal: red/pink -->
    <path
        android:fillColor="#E11D48"
        android:pathData="M56,56 L78,56 A8,8 0 0 1 86,64 L86,78 A8,8 0 0 1 78,86 L64,86 A8,8 0 0 1 56,78 L56,56 Z" />

    <!-- Cursor-arrow glyphs on the two bottom petals -->
    <group android:translateX="26" android:translateY="61">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M0,0 L0,13 L3.2,9.8 L5.8,15 L8,14 L5.5,8.8 L9.5,8.8 Z" />
    </group>
    <group android:translateX="60" android:translateY="61">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M0,0 L0,13 L3.2,9.8 L5.8,15 L8,14 L5.5,8.8 L9.5,8.8 Z" />
    </group>
</vector>
