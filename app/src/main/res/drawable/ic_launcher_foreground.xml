<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: new brand mark (drawable-nodpi/logo.png) inset into the
     108dp canvas so it sits inside the ~66dp safe zone once the launcher masks/crops it. -->
